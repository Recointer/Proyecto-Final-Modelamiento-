# Copie este archivo a .env.prod (en la raíz) y complete los valores. NO lo suba a git.
# Genere contraseñas largas, por ejemplo con:  openssl rand -base64 24

# Contraseña del superusuario de PostgreSQL (solo para migraciones)
POSTGRES_PASSWORD=cambiar
# Contraseña del rol de la aplicación (sin permisos de administración ni BYPASSRLS)
APP_DB_PASSWORD=cambiar

# Dirección pública del sistema (con https:// en producción)
APP_URL=http://localhost:3000
APP_PORT=3000
# Solo si activa HTTPS automático con Caddy (--profile https)
DOMINIO=

# Correo saliente (avisos de convocatorias y recuperación de contraseña). Ejemplo:
# SMTP_URL=smtp://usuario:clave@smtp.proveedor.com:587
SMTP_URL=
MAIL_FROM=no-responder@su-dominio.ec

# Google Maps (opcional; sin clave el mapa de predios se muestra como lista con coordenadas).
# Se incorpora al compilar la imagen: si la cambia, reconstruya con --build.
NEXT_PUBLIC_GOOGLE_MAPS_API_KEY=
NEXT_PUBLIC_GOOGLE_MAPS_MAP_ID=
